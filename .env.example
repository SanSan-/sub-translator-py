# Сетевой переводчик OpenAI. Оставьте пустым, если он не используется.
OPENAI_API_KEY=
TRANSLATOR_AGENT_MODEL=gpt-5.6-luna

# Hugging Face Hub. Для закрытых моделей достаточно одного токена чтения.
HF_TOKEN=
HUGGINGFACE_TOKEN=
HF_HOME=<local-hf-cache>
HUGGINGFACE_HUB_CACHE=<local-hf-cache>/hub

# Явно включаемая автономная приёмка реальных TranslateGemma 12B и Seed-X.
RUN_HEAVY_LOCAL_MODEL_INTEGRATION=0
SUB_TRANSLATOR_TRANSLATEGEMMA_12B_MODEL_PATH=<repo-root>/models/translategemma-12b-it
SUB_TRANSLATOR_TRANSLATEGEMMA_12B_WORKER_PYTHON=<worker-python-path>
SUB_TRANSLATOR_SEEDX_MODEL_PATH=<repo-root>/models/seed-x-ppo-7b
SUB_TRANSLATOR_SEEDX_WORKER_PYTHON=<worker-python-path>

# Локальный SonarQube. Токен не хранится в репозитории.
SONAR_HOST_URL=<sonar-url>
SONAR_TOKEN=
